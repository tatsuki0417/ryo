{
  "name": "ryo-remote",
  "version": "1.0.0",
  "description": "スマホから自分のPCを操作する外部ツール（電源操作・カメラ映像）。Node.js標準機能のみで動作、追加インストール不要。",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "ryo-remote": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "setup": "node src/setup.js",
    "install-tunnel": "node src/install-cloudflared.js",
    "doctor": "node src/doctor.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
